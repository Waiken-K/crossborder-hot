      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 120, "tags": ["监管机构", "制裁", "风险/故障"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "x-lz-rational-invest", "name": "X · @LZRationalnvest（跨境税务与资产讨论）", "kind": "x_search",
      "config": { "query": "from:LZRationalnvest -filter:replies", "searchType": "Latest", "_aihot": { "initialBackfillLimit": 8 } },
