{
  "$comment": "跨境热点首批信号源。来源池来自运营飞书表；这里只启用已实际试抓通过的官方源。需要付费 API 的 X 线索源先保留为 disabled。",
  "sources": [
    {
      "id": "rss-wise-status",
      "name": "Wise Status",
      "kind": "rss",
      "config": { "feedUrl": "https://status.wise.com/history.atom", "_aihot": { "initialBackfillLimit": 12 } },
      "tier": "T1", "first_party": true, "owner_entity_id": "wise", "participation_mode": "editorial",
      "interval_minutes": 60, "tags": ["官方", "Wise", "风险/故障"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "rss-sec-press-releases",
      "name": "美国证券交易委员会（SEC）",
      "kind": "rss",
      "config": { "feedUrl": "https://www.sec.gov/news/pressreleases.rss", "_aihot": { "initialBackfillLimit": 12 } },
      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 180, "tags": ["监管机构", "政策/监管", "美国"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "web-finra-news-releases",
      "name": "美国金融业监管局（FINRA）",
      "kind": "web_list",
      "config": {
        "url": "https://www.finra.org/media-center/newsreleases", "parseMode": "html",
        "itemSelector": ".views-infinite-scroll-content-wrapper > .views-row",
        "linkSelector": ".views-field-title a", "titleSelector": ".views-field-title a",
        "publishedAtSelector": ".views-field-field-core-official-dt time",
        "allowUrlPrefixes": ["https://www.finra.org/media-center/newsreleases/"],
        "_aihot": { "initialBackfillLimit": 10 }
      },
      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 180, "tags": ["监管机构", "券商", "美国"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "rss-cfpb-newsroom",
      "name": "美国消费者金融保护局（CFPB）",
      "kind": "rss",
      "config": { "feedUrl": "https://www.consumerfinance.gov/about-us/newsroom/feed/", "_aihot": { "initialBackfillLimit": 12 } },
      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 120, "tags": ["监管机构", "金融消费者", "美国"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "web-irs-newsroom",
      "name": "IRS（美国国税局）Newsroom",
      "kind": "web_list",
      "config": {
        "url": "https://www.irs.gov/newsroom", "parseMode": "html",
        "itemSelector": ".block-views-blocknewsroom-articles-latest-news-releases-block .views-row",
        "linkSelector": "h3 a", "titleSelector": "h3 a",
        "publishedAtRegex": "(?:IR-[0-9-]+,\\s*)?([A-Z][a-z]{2,8}\\.?\\s*\\d{1,2},\\s+\\d{4})",
        "publishedAtUtcOffset": "-04:00", "allowUrlPrefixes": ["https://www.irs.gov/newsroom/"],
        "_aihot": { "initialBackfillLimit": 15 }
      },
      "tier": "T1", "first_party": true, "owner_entity_id": "irs", "participation_mode": "editorial",
      "interval_minutes": 180, "tags": ["监管机构", "ITIN", "美国税务"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "web-hkma-press-releases",
      "name": "香港金融管理局（HKMA）",
      "kind": "web_list",
      "config": {
        "url": "https://www.hkma.gov.hk/eng/news-and-media/press-releases/", "parseMode": "html",
        "itemSelector": "#press-release-result > ul", "linkSelector": "li a", "titleSelector": "li a",
        "publishedAtSelector": "li:first-child", "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": ["https://www.hkma.gov.hk/eng/news-and-media/press-releases/"],
        "_aihot": { "initialBackfillLimit": 12 }
      },
      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 120, "tags": ["监管机构", "香港银行", "政策/监管"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "web-iras-newsroom",
      "name": "新加坡国内税务局（IRAS）",
      "kind": "web_list",
      "config": {
        "url": "https://www.iras.gov.sg/news-events/newsroom", "parseMode": "html",
        "itemSelector": ".eyd-listing-results__articles > article.eyd-article-item", "linkSelector": "h3 a", "titleSelector": "h3 a",
        "publishedAtSelector": ".eyd-article-item__meta--date", "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": ["https://www.iras.gov.sg/news-events/newsroom/"],
        "_aihot": { "initialBackfillLimit": 12 }
      },
      "tier": "T1", "first_party": true, "owner_entity_id": null, "participation_mode": "editorial",
      "interval_minutes": 180, "tags": ["监管机构", "新加坡税务", "政策/监管"], "site_fulltext": false, "syndicate_fulltext": false
    },
    {
      "id": "web-ofac-recent-actions",
      "name": "美国财政部 OFAC 制裁公告",
      "kind": "web_list",
      "config": {
        "url": "https://ofac.treasury.gov/recent-actions", "parseMode": "html",
        "itemSelector": ".view-recent-actions-search .view-content > .search-result.views-row",
        "linkSelector": ".font-sans-lg a", "titleSelector": ".font-sans-lg a",
        "publishedAtRegex": "([A-Z][a-z]+\\s+\\d{2},\\s+\\d{4})", "publishedAtUtcOffset": "-04:00",
        "allowUrlPrefixes": ["https://ofac.treasury.gov/recent-actions/"],
        "denyUrlPrefixes": ["https://ofac.treasury.gov/recent-actions/sanctions-list-updates"],
        "_aihot": { "initialBackfillLimit": 10 }
