      "tier": "T2", "first_party": false, "owner_entity_id": null, "participation_mode": "hot_signal", "interval_minutes": 120,
      "tags": ["X线索", "产品动态", "风险/故障", "需回查一手来源"], "site_fulltext": false, "syndicate_fulltext": false, "enabled": false
