# Production skeleton. Generate every secret independently; never commit the completed file.
SITE_URL=https://example.com
SITE_DOMAIN=example.com
PORT=127.0.0.1:3000
# Image published by the main-branch GitHub Actions run.
APP_IMAGE=ghcr.io/owner/repository:main
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
POSTGRES_PASSWORD=

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# Enable these only after sources, budgets, and model configuration have been reviewed.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
TRUST_PROXY=true
