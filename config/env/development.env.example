# Copy to .env for local or cloud development. No paid or external calls are enabled.
SITE_URL=http://localhost:3000
ADMIN_PASSWORD=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-a-random-64-character-secret
IMG_PROXY_SIGN_SECRET=replace-with-a-different-random-64-character-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://aihot:replace-with-a-random-database-password@127.0.0.1:5432/aihot_dev
API_BASE_URL=http://127.0.0.1:3001
DEV_AUTH_ROLE=admin

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
TRUST_PROXY=false
